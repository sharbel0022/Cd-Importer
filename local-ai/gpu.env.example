# Opt-in overlay only. Copy to .env.gpu.local; never overwrite .env.local.
STUDIO_LOCAL_URL=http://127.0.0.1:8766
STUDIO_GPU_GATEWAY_PORT=8766
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_REQUIRE_GPU=true
STUDIO_DEMUCS_ENABLED=true
DEMUCS_DEVICE=cuda
TORCH_HOME=local-ai/models/torch-hub
