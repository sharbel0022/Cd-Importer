{
  "name": "cd-importer",
  "version": "1.0.0",
  "private": true,
  "description": "Svensk musikapp för licensierad musik och egna ljudfiler",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file-if-exists=.env.local --import tsx scripts/live-check.ts",
    "test:ui": "node scripts/ui-check.mjs",
    "test:recording": "node --import tsx scripts/recording-check.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.577.0",
    "zod": "^4.3.6",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "^8.5.8",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vitest": "^4.0.18",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.58.2"
  },
  "type": "module"
}
