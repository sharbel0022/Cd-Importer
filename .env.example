# Båda musikkällorna fungerar utan konto eller API-nyckel.
# Identifiera din installation vid många sökningar; ange en verklig kontakt-URL.
MUSIC_USER_AGENT=Cd-Importer/1.0 (+https://github.com/sharbel0022/Cd-Importer)

# Tomt = använd installerat ffmpeg-static. Alternativt absolut sökväg:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Maximal uppladdning i MB (servern begränsar till högst 100).
MAX_UPLOAD_MB=100
# Maximal hämtad ljudfil i MB.
MAX_REMOTE_MB=50

# AI Translation Studio (local Next.js version; restart server AND worker).
# Keys are server-side only. Set providers to local to avoid cloud processing.
OPENAI_API_KEY=
STUDIO_ASR_PROVIDER=openai
STUDIO_TRANSLATION_PROVIDER=openai
STUDIO_TTS_PROVIDER=openai
STUDIO_TRANSLATION_MODEL=gpt-4.1-mini
STUDIO_TTS_MODEL=gpt-4o-mini-tts
STUDIO_LOCAL_URL=http://127.0.0.1:8765
STUDIO_LOCAL_TOKEN=
STUDIO_MAX_UPLOAD_MB=500
STUDIO_MAX_DURATION_SECONDS=3600
STUDIO_DISK_GB=5
STUDIO_RETENTION_HOURS=24
# Current filesystem edition is local single-user. Hosted mode fails closed.
STUDIO_DEPLOYMENT_MODE=local
# Commercial mode requires explicit per-model approvals; see docs/ultimate-studio-hosted-architecture.md.
STUDIO_COMMERCIAL_MODE=false
# STUDIO_LICENSE_APPROVALS_JSON={}
# STUDIO_DATA_DIR=C:\Users\your-user\Cd-Importer-data

# Optional local Python gateway; set these in its terminal environment too.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:12b
# Optional English-only text model; install it before enabling this override.
# OLLAMA_ENGLISH_MODEL=translategemma:12b
# STUDIO_VIDEO_CONTEXT_MODEL=gemma3:12b
# STUDIO_VIDEO_CONTEXT=false
# STUDIO_PIPER_VOICES_JSON=[{"id":"sv-lisa","language":"sv","model":"C:/models/sv_SE-lisa-medium.onnx"}]
# PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# HF_TOKEN=
# STUDIO_DEMUCS_ENABLED=true
# STUDIO_XTTS_ENABLED=true
# Optional Swedish MMS voice, licensed CC-BY-NC-4.0 (noncommercial use).
# STUDIO_MMS_ENABLED=true
# MMS_MODEL=C:/models/mms-tts-swe
# MMS_SEED=555
# STUDIO_ASR_CHUNK_SECONDS=60
# Optional installed acoustic models; client requests can select only these IDs.
# No model is downloaded by health or a segment comparison.
# STUDIO_ASR_MODELS_JSON=[{"id":"turbo","label":"Whisper large-v3-turbo","model":"C:/models/faster-whisper-large-v3-turbo"}]
